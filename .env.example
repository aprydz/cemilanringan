# Root-level env for the monorepo.
# Copy this file to .env and fill in values.

DATABASE_URL="mysql://piscokshop:local_dev_password@127.0.0.1:3306/piscokshop"
CLIENT_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-random-32-char-secret-for-dev"
JWT_REFRESH_TTL_DAYS="7"
SHIPPING_FLAT_RATE_IDR="15000"
PAYMENT_SERVER_KEY="your-midtrans-server-key-min-16-chars"
PAYMENT_API_BASE_URL="https://app.sandbox.midtrans.com"
