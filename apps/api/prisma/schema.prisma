generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}



enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum InventoryLogType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  RESERVED
  APPLIED
  RELEASED
}

model User {
  id                String             @id @default(cuid()) @db.VarChar(30)
  name              String             @db.VarChar(120)
  email             String             @unique @db.VarChar(191)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  phone             String?            @db.VarChar(30)
  role              UserRole           @default(CUSTOMER)
  status            UserStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  addresses         Address[]
  authSessions      AuthSession[]
  carts             Cart[]
  orders            Order[]
  couponRedemptions CouponRedemption[]

  @@index([role, status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid()) @db.VarChar(30)
  userId           String    @map("user_id") @db.VarChar(30)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model Address {
  id            String   @id @default(cuid()) @db.VarChar(30)
  userId        String   @map("user_id") @db.VarChar(30)
  label         String   @db.VarChar(60)
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(30)
  province      String   @db.VarChar(100)
  city          String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  village       String?  @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  address       String   @db.Text
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

model Category {
  id          String        @id @default(cuid()) @db.VarChar(30)
  name        String        @db.VarChar(120)
  slug        String        @unique @db.VarChar(160)
  description String?       @db.Text
  image       String?       @db.VarChar(2048)
  status      RecordStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  products    Product[]

  @@index([status, name])
  @@map("categories")
}

model Product {
  id                String             @id @default(cuid()) @db.VarChar(30)
  categoryId        String             @map("category_id") @db.VarChar(30)
  name              String             @db.VarChar(180)
  slug              String             @unique @db.VarChar(200)
  description       String?            @db.Text
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  variants          ProductVariant[]
  promotionProducts PromotionProduct[]

  @@index([categoryId, status])
  @@index([status, name])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid()) @db.VarChar(30)
  productId String   @map("product_id") @db.VarChar(30)
  url       String   @db.VarChar(2048)
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Flavor {
  id        String           @id @default(cuid()) @db.VarChar(30)
  name      String           @db.VarChar(100)
  slug      String           @unique @db.VarChar(120)
  status    RecordStatus     @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  variants  ProductVariant[]

  @@index([status, name])
  @@map("flavors")
}

model Size {
  id          String           @id @default(cuid()) @db.VarChar(30)
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(120)
  weightGrams Int              @map("weight_grams")
  unit        String           @default("g") @db.VarChar(10)
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  variants    ProductVariant[]

  @@index([status, weightGrams])
  @@map("sizes")
}

model ProductVariant {
  id                String                 @id @default(cuid()) @db.VarChar(30)
  productId         String                 @map("product_id") @db.VarChar(30)
  flavorId          String                 @map("flavor_id") @db.VarChar(30)
  sizeId            String                 @map("size_id") @db.VarChar(30)
  sku               String                 @unique @db.VarChar(100)
  price             Decimal                @db.Decimal(12, 0)
  weightGrams       Int                    @map("weight_grams")
  stockOnHand       Int                    @default(0) @map("stock_on_hand")
  reservedStock     Int                    @default(0) @map("reserved_stock")
  image             String?                @db.VarChar(2048)
  status            RecordStatus           @default(ACTIVE)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  product           Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  flavor            Flavor                 @relation(fields: [flavorId], references: [id], onDelete: Restrict)
  size              Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  cartItems         CartItem[]
  inventoryLogs     InventoryLog[]
  reservations      InventoryReservation[]
  orderItems        OrderItem[]

  @@unique([productId, flavorId, sizeId])
  @@index([productId, status])
  @@index([flavorId, sizeId, status])
  @@map("product_variants")
}

model InventoryLog {
  id               String         @id @default(cuid()) @db.VarChar(30)
  productVariantId String         @map("product_variant_id") @db.VarChar(30)
  type             InventoryLogType
  quantity         Int
  referenceType    String?        @map("reference_type") @db.VarChar(50)
  referenceId      String?        @map("reference_id") @db.VarChar(100)
  note             String?        @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productVariantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_logs")
}

model InventoryReservation {
  id               String              @id @default(cuid()) @db.VarChar(30)
  orderId          String              @map("order_id") @db.VarChar(30)
  productVariantId String              @map("product_variant_id") @db.VarChar(30)
  quantity         Int
  status           ReservationStatus   @default(ACTIVE)
  expiresAt        DateTime            @map("expires_at") @db.DateTime(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([orderId, productVariantId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model Cart {
  id        String     @id @default(cuid()) @db.VarChar(30)
  userId    String?    @unique @map("user_id") @db.VarChar(30)
  sessionId String?    @unique @map("session_id") @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String         @id @default(cuid()) @db.VarChar(30)
  cartId           String         @map("cart_id") @db.VarChar(30)
  productVariantId String         @map("product_variant_id") @db.VarChar(30)
  quantity         Int
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

model Order {
  id                      String                 @id @default(cuid()) @db.VarChar(30)
  orderNumber             String                 @unique @map("order_number") @db.VarChar(40)
  userId                  String?                @map("user_id") @db.VarChar(30)
  guestSessionId          String?                @map("guest_session_id") @db.VarChar(100)
  customerName            String                 @map("customer_name") @db.VarChar(120)
  customerEmail           String                 @map("customer_email") @db.VarChar(191)
  customerPhone           String                 @map("customer_phone") @db.VarChar(30)
  shippingAddressSnapshot Json                   @map("shipping_address_snapshot")
  billingAddressSnapshot  Json?                  @map("billing_address_snapshot")
  subtotal                Decimal                @db.Decimal(15, 0)
  discount                Decimal                @default(0) @db.Decimal(15, 0)
  shippingCost            Decimal                @default(0) @map("shipping_cost") @db.Decimal(15, 0)
  total                   Decimal                @db.Decimal(15, 0)
  couponId                String?                @map("coupon_id") @db.VarChar(30)
  couponCodeSnapshot      String?                @map("coupon_code_snapshot") @db.VarChar(80)
  status                  OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus           PaymentStatus          @default(PENDING) @map("payment_status")
  shippingStatus          ShipmentStatus         @default(PENDING) @map("shipping_status")
  notes                   String?                @db.Text
  createdAt               DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon                  Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  reservations            InventoryReservation[]
  couponRedemption        CouponRedemption?

  @@index([userId, createdAt])
  @@index([guestSessionId])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerEmail, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid()) @db.VarChar(30)
  orderId          String          @map("order_id") @db.VarChar(30)
  productVariantId String?         @map("product_variant_id") @db.VarChar(30)
  productName      String          @map("product_name") @db.VarChar(180)
  flavorName       String          @map("flavor_name") @db.VarChar(100)
  sizeName         String          @map("size_name") @db.VarChar(100)
  sku              String          @db.VarChar(100)
  listPrice        Decimal         @map("list_price") @db.Decimal(12, 0)
  price            Decimal         @db.Decimal(12, 0)
  promotionDiscount Decimal        @default(0) @map("promotion_discount") @db.Decimal(12, 0)
  promotionName    String?         @map("promotion_name") @db.VarChar(150)
  quantity         Int
  subtotal         Decimal         @db.Decimal(15, 0)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model Payment {
  id                    String                 @id @default(cuid()) @db.VarChar(30)
  orderId               String                 @map("order_id") @db.VarChar(30)
  paymentMethod         String                 @map("payment_method") @db.VarChar(60)
  provider              String                 @db.VarChar(60)
  providerTransactionId String?                @map("provider_transaction_id") @db.VarChar(191)
  checkoutUrl           String?                @map("checkout_url") @db.VarChar(2048)
  idempotencyKey        String                 @unique @map("idempotency_key") @db.VarChar(100)
  amount                Decimal                @db.Decimal(15, 0)
  status                PaymentStatus          @default(PENDING)
  paidAt                DateTime?              @map("paid_at") @db.DateTime(3)
  expiredAt             DateTime?              @map("expired_at") @db.DateTime(3)
  rawResponse           Json?                  @map("raw_response")
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  webhookEvents         PaymentWebhookEvent[]

  @@unique([provider, providerTransactionId])
  @@index([orderId, status])
  @@index([status, expiredAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid()) @db.VarChar(30)
  provider    String    @db.VarChar(60)
  eventId     String    @map("event_id") @db.VarChar(191)
  paymentId   String?   @map("payment_id") @db.VarChar(30)
  rawPayload  Json      @map("raw_payload")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.DateTime(3)
  processedAt DateTime? @map("processed_at") @db.DateTime(3)
  processed   Boolean   @default(false)
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([processed, receivedAt])
  @@map("payment_webhook_events")
}

model Shipment {
  id            String          @id @default(cuid()) @db.VarChar(30)
  orderId       String          @map("order_id") @db.VarChar(30)
  courier       String          @db.VarChar(80)
  service       String          @db.VarChar(80)
  trackingNumber String?        @map("tracking_number") @db.VarChar(120)
  shippingCost  Decimal         @map("shipping_cost") @db.Decimal(15, 0)
  status        ShipmentStatus  @default(PENDING)
  shippedAt     DateTime?       @map("shipped_at") @db.DateTime(3)
  deliveredAt   DateTime?       @map("delivered_at") @db.DateTime(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        ShipmentEvent[]

  @@index([orderId, status])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(cuid()) @db.VarChar(30)
  shipmentId  String         @map("shipment_id") @db.VarChar(30)
  status      ShipmentStatus
  description String?        @db.VarChar(500)
  occurredAt  DateTime       @map("occurred_at") @db.DateTime(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model Coupon {
  id               String             @id @default(cuid()) @db.VarChar(30)
  code             String             @unique @db.VarChar(80)
  type             DiscountType
  value            Decimal            @db.Decimal(12, 2)
  minimumPurchase  Decimal            @default(0) @map("minimum_purchase") @db.Decimal(15, 0)
  maximumDiscount  Decimal?           @map("maximum_discount") @db.Decimal(15, 0)
  usageLimit       Int?               @map("usage_limit")
  usedCount        Int                @default(0) @map("used_count")
  startsAt         DateTime           @map("starts_at") @db.DateTime(3)
  endsAt           DateTime           @map("ends_at") @db.DateTime(3)
  status           RecordStatus       @default(ACTIVE)
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  orders           Order[]
  redemptions      CouponRedemption[]

  @@index([status, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id        String                 @id @default(cuid()) @db.VarChar(30)
  couponId  String                 @map("coupon_id") @db.VarChar(30)
  userId    String?                @map("user_id") @db.VarChar(30)
  orderId   String                 @unique @map("order_id") @db.VarChar(30)
  discount  Decimal                @db.Decimal(15, 0)
  status    CouponRedemptionStatus @default(RESERVED)
  createdAt DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  coupon    Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, status, createdAt])
  @@index([userId, couponId])
  @@map("coupon_redemptions")
}

model Promotion {
  id                String             @id @default(cuid()) @db.VarChar(30)
  name              String             @db.VarChar(150)
  description       String?            @db.Text
  type              DiscountType
  value             Decimal            @db.Decimal(12, 2)
  startsAt          DateTime           @map("starts_at") @db.DateTime(3)
  endsAt            DateTime           @map("ends_at") @db.DateTime(3)
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  promotionProducts PromotionProduct[]

  @@index([status, startsAt, endsAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String    @map("promotion_id") @db.VarChar(30)
  productId   String    @map("product_id") @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}